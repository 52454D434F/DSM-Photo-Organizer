#!/bin/sh
# Copyright (C) 2000-2020 Synology Inc. All rights reserved.

### This script will be executed when package installed and upgraded.
### Actions after package installed.
### ex. create database, create symbolic link...

# Primary location for run-as: package
APP_DIR="/var/packages/JsonServer/target/usr/local/JsonServer"
PACKAGE_VAR_DIR="/var/packages/JsonServer"
NODE_MODULES_DIR="$PACKAGE_VAR_DIR/node_modules"

# Check if /var/packages/JsonServer is writable, if not use package destination
if [ ! -d "$PACKAGE_VAR_DIR" ] || [ ! -w "$PACKAGE_VAR_DIR" ]; then
    if [ -n "$SYNOPKG_PKGDEST" ]; then
        PACKAGE_VAR_DIR="$SYNOPKG_PKGDEST/var"
        NODE_MODULES_DIR="$PACKAGE_VAR_DIR/node_modules"
    else
        PACKAGE_VAR_DIR="$APP_DIR/var"
        NODE_MODULES_DIR="$PACKAGE_VAR_DIR/node_modules"
    fi
fi

# Logging function with multiple fallback methods
_log_message() {
    local msg="$1"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    # Method 1: Standard logger command (preferred - works via syslog, no file permissions needed)
    if command -v logger >/dev/null 2>&1; then
        logger -t JsonServer -p user.info "$msg" 2>/dev/null || true
    fi
    
    # Method 1b: Synology-specific synologset1 (fallback if logger doesn't work)
    # Format: synologset1 <facility> <level> <id> <message>
    # 0x11800000 is a generic system info ID (empty category)
    if command -v synologset1 >/dev/null 2>&1; then
        synologset1 sys info 0x11800000 "[JSON Server] $msg" 2>/dev/null || true
    fi
    
    # Method 2: Write to package-specific log file (always accessible to package user)
    # On DSM, /var/packages/JsonServer/var is a symlink to /volume1/@appdata/JsonServer
    local pkg_log_file="/var/packages/JsonServer/var/install.log"
    # Try the symlink location first
    if [ -L "/var/packages/JsonServer/var" ] || [ -d "/var/packages/JsonServer/var" ]; then
        mkdir -p "/var/packages/JsonServer/var" 2>/dev/null || true
        if [ -w "/var/packages/JsonServer/var" ]; then
            echo "[$timestamp] $msg" >> "$pkg_log_file" 2>/dev/null || true
        fi
    fi
    # Fallback to PACKAGE_VAR_DIR if var symlink doesn't work
    if [ -n "$PACKAGE_VAR_DIR" ] && [ "$PACKAGE_VAR_DIR" != "/var/packages/JsonServer/var" ]; then
        local alt_log_file="$PACKAGE_VAR_DIR/install.log"
        mkdir -p "$PACKAGE_VAR_DIR" 2>/dev/null || true
        if [ -w "$PACKAGE_VAR_DIR" ]; then
            echo "[$timestamp] $msg" >> "$alt_log_file" 2>/dev/null || true
        fi
    fi
    
    # Note: We don't write to SYNOPKG_TEMP_LOGFILE to avoid cluttering Package Center output
    # All information is logged to system logs and package log files
}

# Load package version
. "$(dirname "$0")/_version.sh" 2>/dev/null || PACKAGE_VERSION="1.0.0-00001"

# Log installation start to system log
_log_message "Starting installation: Package version $PACKAGE_VERSION"
_log_message "Installation path: $APP_DIR"
_log_message "Node modules directory: $NODE_MODULES_DIR"

# Create package var directory
mkdir -p "$PACKAGE_VAR_DIR" 2>>$SYNOPKG_TEMP_LOGFILE || {
    echo "ERROR: Failed to create directory: $PACKAGE_VAR_DIR" >> $SYNOPKG_TEMP_LOGFILE
    _log_message "ERROR: Failed to create directory: $PACKAGE_VAR_DIR"
    exit 1
}

# Set permissions on application directory
chmod 755 "$APP_DIR" 2>/dev/null || true

# Make json-server-start.js executable
if [ -f "$APP_DIR/json-server-start.js" ]; then
    chmod +x "$APP_DIR/json-server-start.js"
fi

# Get Node.js command from preinst
if [ -f "/tmp/json_server_node_cmd" ]; then
    NODE_CMD=$(cat /tmp/json_server_node_cmd)
    rm -f /tmp/json_server_node_cmd
else
    NODE_CMD="node"
fi

# Get npm command (usually same path as node but with npm)
NPM_CMD="npm"
if command -v npm18 >/dev/null 2>&1; then
    NPM_CMD="npm18"
fi

# Create data directory for db.json (default location, may be overridden by wizard)
DATA_DIR="$PACKAGE_VAR_DIR/data"
mkdir -p "$DATA_DIR" 2>/dev/null || true

# Copy or create config.ini
CONFIG_FILE="$PACKAGE_VAR_DIR/config.ini"
CONFIG_EXISTS=false
if [ -f "$CONFIG_FILE" ]; then
    CONFIG_EXISTS=true
fi

# Check if wizard values are provided
# Note: WIZARD_UIFILES uses the key names directly as environment variables (e.g., "UI_PORT" not "pkgwizard_UI_PORT")
# Also check for legacy formats: pkgwizard_* and wizard_* prefixes
# Wizard values always take priority when provided
# Debug: Log all environment variables that might be wizard values
_log_message "Checking for wizard variables..."
env | grep -E "^(UI_PORT|DB_PATH|DB_FILENAME|pkgwizard_|wizard_)" 2>/dev/null | while IFS='=' read -r key value; do
    _log_message "  Found: $key=$value"
done || _log_message "  No wizard variables found in environment"

WIZARD_VALUES_PROVIDED=false
# Check for WIZARD_UIFILES format (direct key names) first, then legacy formats
if [ -n "$UI_PORT" ] || [ -n "$DB_PATH" ] || [ -n "$DB_FILENAME" ] || \
   [ -n "$pkgwizard_UI_PORT" ] || [ -n "$wizard_UI_PORT" ] || \
   [ -n "$pkgwizard_DB_PATH" ] || [ -n "$wizard_DB_PATH" ] || \
   [ -n "$pkgwizard_DB_FILENAME" ] || [ -n "$wizard_DB_FILENAME" ]; then
    WIZARD_VALUES_PROVIDED=true
    _log_message "Wizard values detected - they will take priority over existing configuration"
    # Debug: log which wizard values were provided
    [ -n "$UI_PORT" ] && _log_message "  Wizard UI_PORT (direct): $UI_PORT"
    [ -n "$pkgwizard_UI_PORT" ] && _log_message "  Wizard UI_PORT (pkgwizard): $pkgwizard_UI_PORT"
    [ -n "$wizard_UI_PORT" ] && _log_message "  Wizard UI_PORT (wizard): $wizard_UI_PORT"
    [ -n "$DB_PATH" ] && _log_message "  Wizard DB_PATH (direct): $DB_PATH"
    [ -n "$pkgwizard_DB_PATH" ] && _log_message "  Wizard DB_PATH (pkgwizard): $pkgwizard_DB_PATH"
    [ -n "$wizard_DB_PATH" ] && _log_message "  Wizard DB_PATH (wizard): $wizard_DB_PATH"
    [ -n "$DB_FILENAME" ] && _log_message "  Wizard DB_FILENAME (direct): $DB_FILENAME"
    [ -n "$pkgwizard_DB_FILENAME" ] && _log_message "  Wizard DB_FILENAME (pkgwizard): $pkgwizard_DB_FILENAME"
    [ -n "$wizard_DB_FILENAME" ] && _log_message "  Wizard DB_FILENAME (wizard): $wizard_DB_FILENAME"
else
    _log_message "No wizard values detected"
fi

# Apply wizard settings: port number
# Wizard value always takes priority if provided
# Try WIZARD_UIFILES format (direct key) first, then legacy formats
if [ -n "$UI_PORT" ]; then
    PORT="$UI_PORT"
    _log_message "Using wizard port value (UI_PORT): $PORT"
elif [ -n "$pkgwizard_UI_PORT" ]; then
    PORT="$pkgwizard_UI_PORT"
    _log_message "Using wizard port value (pkgwizard_UI_PORT): $PORT"
elif [ -n "$wizard_UI_PORT" ]; then
    PORT="$wizard_UI_PORT"
    _log_message "Using wizard port value (wizard_UI_PORT): $PORT"
else
    PORT=3000
    _log_message "Using default port: $PORT"
fi
PORT=$(echo "$PORT" | tr -d ' ')
if [ -z "$PORT" ] || [ "$PORT" = "" ]; then
    PORT=3000
fi

# Apply wizard settings: database file path
# Try WIZARD_UIFILES format (direct key) first, then legacy formats
if [ -n "$DB_PATH" ]; then
    DB_PATH="$DB_PATH"
    _log_message "Using wizard DB_PATH (DB_PATH): $DB_PATH"
elif [ -n "$pkgwizard_DB_PATH" ]; then
    DB_PATH="$pkgwizard_DB_PATH"
    _log_message "Using wizard DB_PATH (pkgwizard_DB_PATH): $DB_PATH"
elif [ -n "$wizard_DB_PATH" ]; then
    DB_PATH="$wizard_DB_PATH"
    _log_message "Using wizard DB_PATH (wizard_DB_PATH): $DB_PATH"
else
    DB_PATH="/var/packages/JsonServer/var/data"
    _log_message "Using default DB_PATH: $DB_PATH"
fi
DB_PATH=$(echo "$DB_PATH" | tr -d ' ')
if [ -z "$DB_PATH" ] || [ "$DB_PATH" = "" ]; then
    DB_PATH="/var/packages/JsonServer/var/data"
fi
# Remove trailing slashes
DB_PATH=$(echo "$DB_PATH" | sed 's:/*$::')

# Apply wizard settings: database file name
# Try WIZARD_UIFILES format (direct key) first, then legacy formats
if [ -n "$DB_FILENAME" ]; then
    DB_FILENAME="$DB_FILENAME"
    _log_message "Using wizard DB_FILENAME (DB_FILENAME): $DB_FILENAME"
elif [ -n "$pkgwizard_DB_FILENAME" ]; then
    DB_FILENAME="$pkgwizard_DB_FILENAME"
    _log_message "Using wizard DB_FILENAME (pkgwizard_DB_FILENAME): $DB_FILENAME"
elif [ -n "$wizard_DB_FILENAME" ]; then
    DB_FILENAME="$wizard_DB_FILENAME"
    _log_message "Using wizard DB_FILENAME (wizard_DB_FILENAME): $DB_FILENAME"
else
    DB_FILENAME="db.json"
    _log_message "Using default DB_FILENAME: $DB_FILENAME"
fi
DB_FILENAME=$(echo "$DB_FILENAME" | tr -d ' ')
if [ -z "$DB_FILENAME" ] || [ "$DB_FILENAME" = "" ]; then
    DB_FILENAME="db.json"
fi

# Construct full database file path
DB_FILE="$DB_PATH/$DB_FILENAME"

# Create database directory if it doesn't exist
mkdir -p "$DB_PATH" 2>/dev/null || {
    echo "ERROR: Failed to create database directory: $DB_PATH" >> $SYNOPKG_TEMP_LOGFILE
    _log_message "ERROR: Failed to create database directory: $DB_PATH"
    # Fallback to default location
    DB_PATH="$DATA_DIR"
    DB_FILE="$DATA_DIR/$DB_FILENAME"
    mkdir -p "$DB_PATH" 2>/dev/null || true
}

# Update config.ini with wizard settings
# Wizard values ALWAYS take priority when provided, even during upgrades
# If wizard values were provided, always update config.ini
# Otherwise, only create/update if config doesn't exist (preserve existing config during upgrades without wizard)
if [ "$WIZARD_VALUES_PROVIDED" = "true" ]; then
    # Wizard values provided - ALWAYS use them (even if config exists)
    {
        echo "[server]"
        echo "port=$PORT"
        echo ""
        echo "[database]"
        echo "db_file=$DB_FILE"
    } > "$CONFIG_FILE"
    _log_message "Configuration file updated with wizard settings (wizard values take priority): port $PORT, database file $DB_FILE"
elif [ "$CONFIG_EXISTS" = "false" ]; then
    # No wizard values and no existing config - create with defaults
    {
        echo "[server]"
        echo "port=$PORT"
        echo ""
        echo "[database]"
        echo "db_file=$DB_FILE"
    } > "$CONFIG_FILE"
    _log_message "Configuration file created with default settings: port $PORT, database file $DB_FILE"
else
    # No wizard values but config exists - preserve existing config during upgrades
    if [ -f "$CONFIG_FILE" ]; then
        EXISTING_PORT=$(grep -E "^port=" "$CONFIG_FILE" | cut -d'=' -f2 | tr -d ' ' || echo "unknown")
        EXISTING_DB=$(grep -E "^db_file=" "$CONFIG_FILE" | cut -d'=' -f2 | tr -d ' ' || echo "")
        if [ -n "$EXISTING_DB" ] && [ "$EXISTING_DB" != "unknown" ]; then
            DB_FILE="$EXISTING_DB"
        fi
        _log_message "Existing configuration preserved (no wizard values provided): port $EXISTING_PORT, database file $DB_FILE"
    fi
fi

# Create db.json if it doesn't exist at the configured location
if [ ! -f "$DB_FILE" ]; then
    DB_DIR=$(dirname "$DB_FILE")
    
    # Try to create directory if it doesn't exist
    if [ ! -d "$DB_DIR" ]; then
        mkdir -p "$DB_DIR" 2>/dev/null || {
            _log_message "WARNING: Cannot create directory $DB_DIR - package user may not have permissions"
            _log_message "The database file will be created by json-server-start.js when the service starts"
            _log_message "If the service fails to start, ensure the JsonServer user has write access to: $DB_DIR"
        }
    fi
    
    # Check if we can write to the directory (if it exists)
    if [ -d "$DB_DIR" ] && [ -w "$DB_DIR" ]; then
        # Use default db.json from package
        if [ -f "$APP_DIR/db.json" ]; then
            cp "$APP_DIR/db.json" "$DB_FILE" 2>/dev/null || {
                _log_message "WARNING: Cannot copy default db.json to $DB_FILE - permission denied"
                _log_message "The file will be created by json-server-start.js when the service starts"
            }
            if [ -f "$DB_FILE" ]; then
                _log_message "Default db.json copied to $DB_FILE"
            fi
        else
            # Fallback: create minimal default db.json
            echo '{"posts":[],"comments":[],"profile":{}}' > "$DB_FILE" 2>/dev/null || {
                _log_message "WARNING: Cannot create default db.json at $DB_FILE - permission denied"
                _log_message "The file will be created by json-server-start.js when the service starts"
            }
            if [ -f "$DB_FILE" ]; then
                _log_message "Minimal default db.json created at $DB_FILE"
            fi
        fi
    else
        _log_message "WARNING: Directory $DB_DIR is not writable by package user"
        _log_message "The database file will be created by json-server-start.js when the service starts"
        _log_message "If the service fails to start, ensure the JsonServer user has write access to: $DB_DIR"
    fi
fi

# Install json-server globally or locally
# Try to install in node_modules directory
cd "$PACKAGE_VAR_DIR"

# Clean up any problematic npm cache directories that might have permission issues
# Check for npm cache in package home directory
if [ -d "$PACKAGE_VAR_DIR/.npm" ]; then
    # Try to remove if it has permission issues, but don't fail if we can't
    rm -rf "$PACKAGE_VAR_DIR/.npm" 2>/dev/null || true
fi

# Create package.json if it doesn't exist
if [ ! -f "$PACKAGE_VAR_DIR/package.json" ]; then
    {
        echo "{"
        echo "  \"name\": \"json-server-package\","
        echo "  \"version\": \"1.0.0\","
        echo "  \"description\": \"JSON Server for Synology DSM\","
        echo "  \"dependencies\": {"
        echo "    \"json-server\": \"^0.17.4\""
        echo "  }"
        echo "}"
    } > "$PACKAGE_VAR_DIR/package.json"
fi

# Install json-server
_log_message "json-server installation started"

# Create npm cache directory that package user can write to
NPM_CACHE_DIR="$PACKAGE_VAR_DIR/.npm-cache"
mkdir -p "$NPM_CACHE_DIR" 2>/dev/null || true

# Fix any existing npm cache issues by using a clean cache directory
# Set npm to use our writable cache directory
export npm_config_cache="$NPM_CACHE_DIR"
export NPM_CONFIG_CACHE="$NPM_CACHE_DIR"

# Also set HOME to package var dir to avoid issues with .npm in user home
export HOME="$PACKAGE_VAR_DIR"

# Suppress npm notices (funding, update notifications) but keep errors/warnings
# Use --cache flag to explicitly set cache location
NPM_CONFIG_UPDATE_NOTIFIER=false "$NPM_CMD" install json-server --prefix "$PACKAGE_VAR_DIR" --cache "$NPM_CACHE_DIR" --no-fund --loglevel=warn >> $SYNOPKG_TEMP_LOGFILE 2>&1
if [ $? -ne 0 ]; then
    echo "ERROR: Failed to install json-server" >> $SYNOPKG_TEMP_LOGFILE
    _log_message "ERROR: Failed to install json-server"
    # Try to provide helpful error message
    echo "If this is a permission error, try:" >> $SYNOPKG_TEMP_LOGFILE
    echo "  sudo chown -R $(whoami) \"$NPM_CACHE_DIR\"" >> $SYNOPKG_TEMP_LOGFILE
    exit 1
fi

_log_message "json-server installed successfully"

# Get versions
NODE_VER=$("$NODE_CMD" --version 2>&1 | sed 's/v//')
NPM_VER=$("$NPM_CMD" --version 2>&1)
JSON_SERVER_VER=$("$NODE_CMD" "$NODE_MODULES_DIR/.bin/json-server" --version 2>/dev/null || echo "N/A")

# Log detailed information to system log (visible in Log Center)
# One item per line for better readability
_log_message "DSM Package version: $PACKAGE_VERSION"
_log_message "Installation path: $APP_DIR"
_log_message "Node modules directory: $NODE_MODULES_DIR"
_log_message "Node.js version: $NODE_VER"
_log_message "npm version: $NPM_VER"
_log_message "Node json-server version: $JSON_SERVER_VER"
_log_message "Configuration file: $CONFIG_FILE"
_log_message "Database file: $DB_FILE"
_log_message "Server port: $PORT"
_log_message "json-server installation completed successfully"

exit 0